# ─────────────────────────────────────────────────────────
# FutureCV — Backend AI Service (.env)
# Copy this file to .env and configure your environment.
# ─────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────
APP_NAME=FutureCV Backend AI
ENV=development

# ── Server ──────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── LLM Provider ────────────────────────────────────────
# Supported: "mock" | "openai" | "gemini"
# Default is "mock" for local development/offline execution without API keys.
LLM_PROVIDER=mock
# Model names:
# - openai: gpt-4o-mini
# - gemini: gemini-3.5-flash-lite (or gemini-flash-latest)
LLM_MODEL=gpt-4o-mini

# ── Matching Algorithm ──────────────────────────────────
# Supported:
# - matching-v0: default stable baseline
# - matching-v1-experimental: uncalibrated experimental weights
MATCHING_ALGORITHM=matching-v0

# ── Embedding Provider ──────────────────────────────────
# Supported: "mock" (offline/deterministic) | "openai" | "gemini"
EMBEDDING_PROVIDER=mock
# Model names:
# - openai: text-embedding-3-small
# - gemini: gemini-embedding-2 (or text-embedding-004)
EMBEDDING_MODEL=gemini-embedding-2

# ── Semantic Matching Mode ──────────────────────────────
# Supported:
# - advisory: compute embeddings and provide semantic similarity in metadata (shadow mode, does not alter match_score)
# - integrated: blend semantic similarity into final match score (matching-v1 formula)
# - disabled: do not compute embeddings
SEMANTIC_MODE=advisory

# Provider API keys:
# OPENAI_API_KEY is required when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# Dedicated Gemini keys for LLM and Embedding, with fallback to GEMINI_API_KEY:
# - LLM uses GEMINI_LLM_API_KEY, falls back to GEMINI_API_KEY if unset
# - Embedding uses GEMINI_EMBEDDING_API_KEY, falls back to GEMINI_API_KEY if unset
GEMINI_API_KEY=
GEMINI_LLM_API_KEY=
GEMINI_EMBEDDING_API_KEY=


# ── Internal Service Authentication ─────────────────────
# Pre-shared secret for ASP.NET Core -> FastAPI communication.
# Sent in header: X-Internal-API-Key
# (Optional in development/test; strictly required in production).
INTERNAL_API_KEY=futurecv-demo-local-2026

# ── LLM Resilience ─────────────────────────────────────
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1

# ── Logging ─────────────────────────────────────────────
# Levels: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Security & Document Constraints ─────────────────────
# Maximum file upload size in bytes (Default: 5MB = 5242880 bytes)
MAX_UPLOAD_SIZE_BYTES=5242880
# Maximum PDF pages allowed for parsing (Default: 20 pages)
MAX_PDF_PAGES=20
# Maximum text characters extracted from CV document
MAX_EXTRACTED_TEXT_CHARS=50000

# ── Multimodal OCR Fallback ─────────────────────────────
# Automatically fallback to Gemini Vision OCR if PDF has no text layer or < threshold chars
ENABLE_OCR_FALLBACK=true
OCR_MIN_CHAR_THRESHOLD=50
